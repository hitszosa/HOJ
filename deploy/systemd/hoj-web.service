[Unit]
Description=HOJ Course Web Frontend (Next.js)
After=network.target hoj-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/oj/course-service/web
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/npm run start -- -p 3100
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
