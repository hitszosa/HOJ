FROM node:24-bookworm-slim AS build
WORKDIR /src/teacher-management/frontend
COPY teacher-management/frontend/package.json teacher-management/frontend/pnpm-lock.yaml ./
COPY teacher-management/frontend/pnpm-workspace.yaml ./
COPY teacher-management/frontend/vendor ./vendor
RUN npm install --global pnpm@11.28.3 --no-audit --no-fund \
 && pnpm install --frozen-lockfile
COPY teacher-management/frontend ./
# Both interfaces use the same role and route policy.
COPY frontend/src/lib/platform-navigation.ts /src/frontend/src/lib/platform-navigation.ts
RUN pnpm build
FROM nginx:stable-bookworm
COPY --from=build /src/teacher-management/frontend/dist /usr/share/nginx/html/management
COPY deploy/remote/management-nginx.conf /etc/nginx/conf.d/default.conf
