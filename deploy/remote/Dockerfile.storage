# Official MinIO source release; old public binary registries no longer serve this image.
FROM golang:1.24.8-bookworm AS build
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
RUN curl -fL --retry 3 "https://github.com/minio/minio/archive/refs/tags/${MINIO_RELEASE}.tar.gz" -o /tmp/minio.tgz \
 && mkdir /src && tar -xzf /tmp/minio.tgz -C /src --strip-components=1
WORKDIR /src
RUN CGO_ENABLED=0 GOMAXPROCS=3 go build -p 3 -trimpath -ldflags="-s -w" -o /minio .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
