# Configure the current MariaDB schema; ordinary releases use ../deploy/scripts/release.py.
DATABASE_URL=mysql://grader:replace-me@host.docker.internal:3306/grader
DATABASE_MAX_CONNECTIONS=50
# Optional Redis acceleration. Unset/empty bypasses Redis; database revisions remain mandatory.
REDIS_URL=
REDIS_KEY_PREFIX=grader-backend
# Bounds: TTL 1..300 seconds, each Redis operation 1..1000 milliseconds.
REDIS_CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_MS=50
BIND=0.0.0.0:8000
# Keep this key unchanged across deployments to preserve existing encrypted cookies.
# Supply base64-encoded 32 or 64 bytes. Do not use this example as a key.
SESSION_SECRET_KEY=replace-with-existing-secret
CSRF_SECRET=replace-with-existing-csrf-secret
COOKIE_SECURE=true
# Existing sessions within this expiry grace can renew after live DB revalidation (0..604800).
SESSION_REFRESH_GRACE_SECONDS=86400
PASSWORD_ITERATIONS=100000
CORS_ORIGINS=https://grader.example.org
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
S3_PUBLIC_URL=https://s3.example.org
S3_INTERNAL_URL=http://storage:9000
S3_BUCKET_NAME=grader-uploads
UPLOAD_TTL_SECONDS=3600
SUGGEST_EXTRACTOR_ENDPOINT=http://suggest-extractor:50051
SUGGEST_EXTRACTOR_TIMEOUT_SECS=60
SUGGEST_EXTRACTOR_CONNECT_TIMEOUT_SECS=5
# Private Gotenberg 8.34+ service for bounded PDF inspection and Word previews; never public.
DOCUMENT_CONVERTER_URL=http://document-converter:3000
HITIDS_AUTH_URI=https://ids.hit.edu.cn/authserver/oauth2.0/authorize
HITIDS_TOKEN_URI=https://ids.hit.edu.cn/authserver/oauth2.0/accessToken
HITIDS_PROFILE_URI=https://ids.hit.edu.cn/authserver/oauthApi/user/profile
HITIDS_CLIENT_ID=
HITIDS_CLIENT_SECRET=
HITIDS_REDIRECT_URI=https://grader.example.org/api/auth/callback
RUST_LOG=info
